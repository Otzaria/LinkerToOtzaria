+@lru_cache(maxsize=64)
+def _cached_dibur_hamatchil_nodes(tref: str):
+    """Materialize one immutable process-local Mongo result per container ref."""
+    logger.info(f"Querying DH for {tref} (cache miss)")
+    nodes = DiburHamatchilNodeSet({"container_refs": tref})
+    # AbstractMongoSet otherwise keeps a live cursor until first iteration. Force
+    # materialization before caching; subsequent iterations reuse its stable records.
+    nodes.array()
+    return nodes
+
+
+def _log_dibur_hamatchil_cache_info():
+    info = _cached_dibur_hamatchil_nodes.cache_info()
+    logger.info(
+        "DH cache summary",
+        hits=info.hits,
+        misses=info.misses,
+        maxsize=info.maxsize,
+        currsize=info.currsize,
+    )
+
+
+atexit.register(_log_dibur_hamatchil_cache_info)
+
+
 class DiburHamatchilNodeSet(abst.AbstractMongoSet, ReferenceableBookNode):
     recordClass = DiburHamatchilNode
