# Python
__pycache__/
*.pyc
.venv/
venv/

# Local linker inputs/outputs that are NOT committed to the repo:
# - the lines snapshot the build produces (large, transient)
# - packed release bundles (published as release assets, not committed)
lines_snapshot.db
*.zst
*.tmp
# Generated link artifacts are the release payload (shipped as linker_links.zst / on Oracle),
# NOT committed. Keep the dir via .gitkeep but ignore everything the linker writes into it.
/artifacts/*
!/artifacts/.gitkeep
